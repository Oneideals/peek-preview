{
  "manifest_version": 3,
  "name": "Peek — 链接悬浮预览",
  "version": "0.5.0",
  "description": "按住 Shift 点击任意链接，内容以悬浮窗出现在当前页面上；支持划词搜索、阅读视图、收藏标签、沉浸模式与自带 Key 的 AI 问答。Arc Peek 的 Chrome 复刻。",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequest",
    "offscreen",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/peek.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_title": "Peek 设置",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
